<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <OutputType>WinExe</OutputType>

    <TargetFramework>net10.0-windows</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>SCXI</AssemblyName>
    <RootNamespace>SCXI</RootNamespace>

    <!-- ============================================================= -->
    <!-- VERSION                                                       -->
    <!-- ============================================================= -->

    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <Product>SCXI</Product>
    <Description>Steam Controller XInput Bridge</Description>

    <ApplicationIcon>Assets\scxi-enabled.ico</ApplicationIcon>

  </PropertyGroup>


  <!-- ============================================================= -->
  <!-- NUGET PACKAGES                                                -->
  <!-- ============================================================= -->

  <ItemGroup>

    <PackageReference
      Include="Viiper.Client"
      Version="0.7.0" />

  </ItemGroup>


  <!-- ============================================================= -->
  <!-- EMBED SCXI TRAY ICONS                                        -->
  <!-- ============================================================= -->

  <ItemGroup>

    <None Remove="Assets\scxi-enabled.ico" />
    <None Remove="Assets\scxi-disabled.ico" />

    <EmbeddedResource
      Include="Assets\scxi-enabled.ico"
      LogicalName="SCXI.Assets.scxi-enabled.ico" />

    <EmbeddedResource
      Include="Assets\scxi-disabled.ico"
      LogicalName="SCXI.Assets.scxi-disabled.ico" />

  </ItemGroup>


  <!-- ============================================================= -->
  <!-- BUNDLED VIIPER SERVER                                        -->
  <!-- ============================================================= -->

  <ItemGroup>

    <None Update="tools\viiper\viiper.exe">

      <CopyToOutputDirectory>
        PreserveNewest
      </CopyToOutputDirectory>

      <CopyToPublishDirectory>
        PreserveNewest
      </CopyToPublishDirectory>

      <ExcludeFromSingleFile>
        true
      </ExcludeFromSingleFile>

      <TargetPath>
        tools\viiper\viiper.exe
      </TargetPath>

    </None>

  </ItemGroup>

</Project>
